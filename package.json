{
  "name": "skrive",
  "version": "1.5.0",
  "description": "A writing app for notes, drafts, and documents — rich, rendered writing in plain files you own.",
  "type": "module",
  "main": "out/main/index.js",
  "workspaces": [
    "app",
    "shell",
    "shared",
    "native/diff"
  ],
  "scripts": {
    "start": "electron-vite dev",
    "start:build": "electron-vite build",
    "start:preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --mac --win",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win",
    "typecheck": "tsc -p shared/tsconfig.json && tsc -p app/tsconfig.json && tsc -p shell/tsconfig.json",
    "perf:fixture": "bun scripts/build-perf-fixture.ts",
    "parity:gen": "bun --preload ./scripts/parity/preload.ts ./scripts/generate-parity-fixtures.ts",
    "parity:check": "bun --preload ./scripts/parity/preload.ts ./scripts/run-parity-fixtures.ts"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.0",
    "@skrive/diff": "workspace:*",
    "character-entities": "^2.0.2",
    "electron-updater": "^6.8.3",
    "marked": "^18.0.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
