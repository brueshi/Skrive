{
  "name": "skrive",
  "version": "1.0.1",
  "description": "A Markdown IDE for people who write seriously and ship to the web.",
  "type": "module",
  "main": "out/main/index.js",
  "workspaces": [
    "app",
    "shell",
    "shared",
    "native/diff"
  ],
  "scripts": {
    "start": "electron-vite dev",
    "start:build": "electron-vite build",
    "start:preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --mac --win",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win",
    "typecheck": "tsc -p shared/tsconfig.json && tsc -p app/tsconfig.json && tsc -p shell/tsconfig.json",
    "perf:fixture": "bun scripts/build-perf-fixture.ts",
    "legacy:dev": "vite dev",
    "legacy:dev:web": "VITE_TARGET=web vite dev",
    "legacy:build": "vite build",
    "legacy:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "legacy:tauri": "tauri"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.0",
    "@skrive/diff": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "character-entities": "^2.0.2",
    "electron-updater": "^6.8.3",
    "marked": "^18.0.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
