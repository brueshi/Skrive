.DS_Store
node_modules
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.claude/
planning/

# Electron build output
/out
/dist
*.tsbuildinfo

# /build is electron-builder's resource dir; allow-list what we keep there.
# Everything else (legacy SvelteKit prerender output, future build artifacts) is ignored.
/build/*
!/build/entitlements.mac.plist
!/build/icon.icns
!/build/icon.ico
!/build/icon.png
!/build/icon-dark.png

# Generated by `bun run perf:fixture` (phase-12b cold-open / file-switch
# / lint-latency budgets). Reproducible from scripts/build-perf-fixture.ts
# alone; committing the 100 generated files would just be log noise on
# any future content tweak.
/docs/fixtures/perf-100/

# Working scratch dir for reference screenshots, paste-board grabs,
# and other workflow artifacts that shouldn't enter history.
/attachments/

# shell-zig build artifacts. All reproducible from source; never commit them.
/shell-zig/core/zig-out/
/shell-zig/core/.zig-cache/
/shell-zig/macos/.build/
/shell-zig/web/dist/
/shell-zig/windows/zig-out/
/shell-zig/windows/.zig-cache/
/shell-zig/windows/dist/
/shell-zig/windows/Skrive-win-*.zip
/shell-zig/windows/Skrive-Windows-*.zip
# Installer outputs (reproducible via package-windows.sh / make-appcast.sh). The
# .nsi, the scripts, and the vendored DLLs/bootstrapper under vendor/ ARE
# tracked; only the compiled Setup.exe + generated feed are ignored.
/shell-zig/windows/installer/*.exe
/shell-zig/windows/installer/appcast-win.xml
